# ============================================================
# Resume Matcher Backend - .env for Oracle Cloud VM
# Copy this to: /opt/resume-matcher/apps/backend/.env
# ============================================================

# ── LLM Provider ────────────────────────────────
# Options: openai, anthropic, gemini, openrouter, deepseek, ollama
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=your-openrouter-api-key-here

# Optional: only needed for Ollama or custom proxy
# LLM_API_BASE=http://localhost:11434

# ── Server Config ───────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend URL (your Vercel deployment) ───────
# Used by backend for PDF generation
FRONTEND_BASE_URL=https://resume-matcher-zeta.vercel.app

# ── CORS: allow your Vercel frontend ────────────
CORS_ORIGINS=["https://resume-matcher-zeta.vercel.app"]

# ── Logging ─────────────────────────────────────
LOG_LEVEL=INFO

# ── Request timeout (seconds) ───────────────────
REQUEST_TIMEOUT_SECONDS=240
